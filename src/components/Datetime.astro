---
import { getPostISOString, formatPostDate } from "@/utils/postDate";
import IconCalendar from "@/assets/icons/IconCalendar.svg";

export interface Props {
  class?: string;
  size?: "sm" | "lg";
  timezone: string | undefined;
  pubDatetime: Date;
  modDatetime?: Date | null;
}

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const isUpdated = Boolean(modDatetime && modDatetime > pubDatetime);
const latestDatetime = isUpdated ? (modDatetime as Date) : pubDatetime;
const date = formatPostDate(latestDatetime, postTimezone);
---

<div class:list={["flex items-center gap-2 opacity-80", className]}>
  <IconCalendar
    class:list={[
      "inline-block size-5 min-w-[1.25rem]",
      { "size-4 min-w-[1rem]": size === "sm" },
    ]}
  />
  {
    isUpdated ? (
      <span class:list={["text-sm italic", { "sm:text-base": size === "lg" }]}>Updated:</span>
    ) : (
      <span class="sr-only">Published:</span>
    )
  }
  <span class:list={["text-sm italic", { "sm:text-base": size === "lg" }]}>
    <time datetime={getPostISOString(latestDatetime)}>{date}</time>
  </span>
</div>
