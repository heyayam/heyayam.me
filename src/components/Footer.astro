---
import { SITE } from "@/config";
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div class="flex flex-col items-center justify-between gap-2 py-6 sm:flex-row-reverse sm:py-4">
    <Socials centered />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>&copy; {year} {SITE.author}</span>
    </div>
  </div>
</footer>
