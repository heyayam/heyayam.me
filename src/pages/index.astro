---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
  <section class="hero">
    <img class="portrait" src="/images/ayam.jpg" alt="Ayam Dhotekar" />
    <div>
      <p class="eyebrow">Photograph</p>
      <h1>Hi, I’m <span>@heyayam</span>.</h1>
      <p class="lede">Low-level systems from Rust roots to intelligent infrastructure.</p>
      <p class="lede muted">Every project starts with curiosity and ends on GitHub.</p>
      <div class="socials" aria-label="Social links">
        <!-- Replace these URLs with your actual accounts before publishing. -->
        <a href="https://github.com/heyayam" rel="me">GitHub ↗</a>
        <a href="https://x.com/heyayam" rel="me">Twitter ↗</a>
        <a href="mailto:hello@heyayam.me">Email ↗</a>
      </div>
    </div>
  </section>
  <section class="recent">
    <div class="section-heading"><h2>Writing</h2><a href="/posts">View all posts →</a></div>
    <div class="post-list">
      {posts.map((post) => <a class="post-row" href={`/posts/${post.id}/`}><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</time></a>)}
    </div>
  </section>
</BaseLayout>
