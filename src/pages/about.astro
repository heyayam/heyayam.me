---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout title={`About | ${SITE.title}`} description={`About ${SITE.author}.`}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <article class="prose mt-8 max-w-3xl">
      <h1>About</h1>

      {/*
        ────────────────────────────────────────────────────────────────
        ABOUT PAGE — blank template, ready for you to fill in.
        Write normal markdown here, or drop the copy in and delete this
        comment. Anything you put inside <article> is styled by the
        `prose` classes, so headings, lists, links, code and images all
        pick up the site's light/dark theming automatically.
        ────────────────────────────────────────────────────────────────
      */}

      <p>
        <em>Coming soon.</em>
      </p>

      <p>
        I'm {SITE.author} — {SITE.bio}
      </p>
    </article>
  </main>

  <Footer />
</Layout>
